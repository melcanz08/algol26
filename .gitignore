# === OS / Editor ===
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.sublime-workspace
.vscode/
.idea/

# === Backup files ===
*.bak
*.bak.*
*.orig
*.rej

# === Python ===
*.pyc
__pycache__/
*.pyo

# === Rust build artifacts ===
/target/
**/*.rs.bk
.fingerprint/
incremental/

# === Algol26 compiled binaries ===
# Keep Cargo.lock for reproducible builds
# But ignore generated binaries
/build/
deps/

# Example binaries (keep .gol source files only)
examples/**/ffi_test
examples/**/generics_test
examples/**/opt_test
examples/**/orthogonal_test
examples/**/pattern_test
examples/**/test
examples/**/test_for
examples/**/trait_bounds_test
examples/**/trait_test
examples/systems/comprehensive_test/full_test
examples/systems/*/main
examples/systems/*/weather
examples/systems/temperature_analyzer
examples/systems/*/temperature_analyzer
examples/ownership/safety/bounds
examples/basic/test
examples/ffi/ffi_test

# Benchmark binaries
benchmarks/programs/large
benchmarks/programs/medium
benchmarks/programs/small
benchmarks/programs/*.out

# Test binaries
tests/programs/valid/fibonacci
tests/programs/valid/hello
tests/programs/valid/move

# Under tests/programs/, only source-adjacent files are tracked.
# Everything else is a compiled artifact from running the tests.
tests/programs/**/*
!tests/programs/**/*.gol
!tests/programs/**/*.sh
!tests/programs/**/*.md
!tests/programs/**/*.txt
!tests/programs/**/*.toml
!tests/programs/**/*.json

# === LLVM/Compiler artifacts ===
*.ll
*.bc
*.o
*.obj
test_output.ll
temperature_report.txt
weather_report.txt

# === Temporary files ===
*.tmp
*.temp

# Adversarial test outputs (compiled binaries)
tests/adversarial/0*
tests/adversarial/1*
tests/adversarial/2*
tests/adversarial/3*
!tests/adversarial/*.gol
!tests/adversarial/*.sh
!tests/adversarial/*.json
!tests/adversarial/*.md

# Adversarial test compiled outputs, cases 30-49
tests/adversarial/3*
tests/adversarial/4*
!tests/adversarial/*.gol
!tests/adversarial/*.sh
!tests/adversarial/*.json
!tests/adversarial/*.md

# Under tests/conformance/, only .gol files are tracked.
# Compiled binaries from `algol26 run <file>` land next to the source.
tests/conformance/**/*
!tests/conformance/**/*.gol
!tests/conformance/**/*.sh
!tests/conformance/**/*.md