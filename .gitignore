# === OS / Editor ===
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.sublime-workspace
.vscode/
.idea/

# === Backup files ===
*.bak
*.bak.*
*.orig
*.rej

# === Python ===
*.pyc
__pycache__/
*.pyo

# === Rust build artifacts ===
/target/
**/*.rs.bk
.fingerprint/
incremental/

# === Algol26 compiled artifacts ===
# Keep Cargo.lock for reproducible builds. Everything else that
# `cargo build` produces is ignored.
/build/
deps/

# LLVM / WASM / object intermediates. Generated by
# `algol26 --emit-llvm` and `algol26 wasm`. Always regeneratable
# from the source `.gol`; never commit.
*.ll
*.bc
*.wasm
*.o
*.obj

# Transient output files written next to source by test programs.
test_output.ll
temperature_report.txt
weather_report.txt

# === Temporary files ===
*.tmp
*.temp

# === Source directories with generated binaries ===
#
# These directories hold `.gol` sources alongside compiled outputs
# produced by running the test/example suites: extensionless
# binaries, `.ll`, `.wasm`. Only source-adjacent files are tracked.
#
# The pattern is the same everywhere: ignore everything under the
# directory, re-include subdirectories (git will not descend into
# an excluded directory), then re-include the extensions that
# represent checked-in content.

# --- examples/ ---
examples/**/*
!examples/**/
!examples/**/*.gol
!examples/**/*.sh
!examples/**/*.md
!examples/**/*.toml
!examples/**/*.json
!examples/**/*.rs

# --- benchmarks/ ---
benchmarks/**/*
!benchmarks/**/
!benchmarks/**/*.gol
!benchmarks/**/*.sh
!benchmarks/**/*.md

# --- tests/programs/ ---
tests/programs/**/*
!tests/programs/**/
!tests/programs/**/*.gol
!tests/programs/**/*.sh
!tests/programs/**/*.md
!tests/programs/**/*.txt
!tests/programs/**/*.toml
!tests/programs/**/*.json

# --- tests/adversarial/ ---
tests/adversarial/**/*
!tests/adversarial/**/
!tests/adversarial/**/*.gol
!tests/adversarial/**/*.sh
!tests/adversarial/**/*.json
!tests/adversarial/**/*.md

# --- tests/conformance/ ---
tests/conformance/**/*
!tests/conformance/**/
!tests/conformance/**/*.gol
!tests/conformance/**/*.sh
!tests/conformance/**/*.md

# --- tests/corpus/ ---
tests/corpus/**/*
!tests/corpus/**/
!tests/corpus/**/*.gol
!tests/corpus/**/*.sh
!tests/corpus/**/*.mdtests/fixtures/*/
audit.json
tests/codegen_probes/*
!tests/codegen_probes/*.gol
# Probe runner writes an executable next to each .gol source.
tests/codegen_probes/*
!tests/codegen_probes/*.gol
