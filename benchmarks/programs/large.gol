trait Comparable
    function compare(other: Self) -> Int

impl Comparable for Int
    function compare(other: Int) -> Int
        if self < other
            return -1
        else if self > other
            return 1
        else
            return 0

function max<T>(a: T, b: T) -> T where T: Comparable
    if a.compare(b) >= 0
        return a
    else
        return b

function add(a: Int, b: Int) -> Int
    return a + b

function multiply(a: Float, b: Float) -> Float
    return a * b

function main() -> Int
    val m := max(5, 10)
    print m
    
    val s := add(3, 4)
    print s
    
    val p := multiply(3.5, 2.0)
    print p
    
    val arr := [1, 2, 3, 4, 5]
    print List.sum(arr)
    
    return 0
