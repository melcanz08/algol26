// fail_borrow_used_in_loop.gol
//
// ADR 0043 — the syntactic last-use analysis cannot tell "used
// once inside a loop body" from "used on every iteration." A use
// inside a loop body promotes the borrow's last use to the
// loop's exit, because on iteration N+1 the same use occurs
// again after iteration N's write.
//
// Here `*r` is used before `count := count + 1` in the source,
// but on iteration 2 the print runs after iteration 1's
// increment. The analyzer conservatively rejects.

proc main
    var count := 0
    val r := &count

    while count < 3
        print(*r)           // use inside loop -> borrow live through exit
        count := count + 1  // E0007: borrow is still live

    print(count)