// ============================================================
// Algol26 — Library Management Showcase
// ============================================================
// Exercises records, nominal types, subranges, enums, traits,
// inherent impls (all three receiver modes), generic records,
// generic impls, Option, Result, match, List, String ops,
// defer, affirm, complex-receiver method calls, ownership.

// ─── Nominal types ────────────────────────────────────────────
type BookId distinct Int
type MemberId distinct Int
type LoanDays Int in 1..30

// ─── Enums ────────────────────────────────────────────────────
enum BookStatus
    Available
    Borrowed
    Lost

enum MemberTier
    Standard
    Premium
    Staff

// ─── Traits ───────────────────────────────────────────────────
trait Describable
    function describe(self: &Self) -> String

// ─── Records ──────────────────────────────────────────────────
rec Book
    id: BookId
    title: String
    author: String
    status: BookStatus
    copies: Int

rec Member
    id: MemberId
    name: String
    tier: MemberTier

rec Loan
    book_id: BookId
    member_id: MemberId
    days: LoanDays

// ─── Generic records: deferred ────────────────────────────────
// `rec Box<T>` runs on the interpreter, but LLVM/WASM codegen for
// generic records is a follow-up (ADR 0036 scope covers non-generic
// records). The showcase omits it so all three backends agree.

// ─── Inherent impl: three receiver modes ──────────────────────
impl Book
    // self: Book — consumes the receiver, returns a new Book
    function retitled(self: Book, new_title: String) -> Book
        return Book {
            id: self.id,
            title: new_title,
            author: self.author,
            status: self.status,
            copies: self.copies
        }

    // self: &Book — shared borrow, read-only
    function is_available(self: &Book) -> Bool
        return self.copies > 0

    // self: &mut Book — exclusive borrow, mutates
    function checkout_copy(self: &mut Book)
        affirm(self.copies > 0, "no copies left to check out")
        self.copies := self.copies - 1
        if self.copies == 0
            self.status := BookStatus.Borrowed

// ─── Trait impls ──────────────────────────────────────────────
impl Describable for Book
    function describe(self: &Book) -> String
        val status_str := match self.status
            case Available
                "available"
            case Borrowed
                "borrowed"
            case Lost
                "lost"
        return self.title.concat(" by ").concat(self.author).concat(" [").concat(status_str).concat("]")

impl Describable for Member
    function describe(self: &Member) -> String
        val tier_str := match self.tier
            case Standard
                "standard"
            case Premium
                "premium"
            case Staff
                "staff"
        return self.name.concat(" (").concat(tier_str).concat(")")

// ─── Generic function ─────────────────────────────────────────
function identity<T>(x: T) -> T
    return x

// ─── Main ─────────────────────────────────────────────────────
proc main
    defer print("")
    defer print("--- exit ---")

    // === Records + nominal types + subranges + enums ===
    val b1 := Book {
        id: BookId.from_base(1),
        title: "The Left Hand of Darkness",
        author: "Ursula K. Le Guin",
        status: BookStatus.Available,
        copies: 3
    }

    var b2 := Book {
        id: BookId.from_base(2),
        title: "Dune",
        author: "Frank Herbert",
        status: BookStatus.Available,
        copies: 1
    }

    // === Complex-receiver method call on a temporary ===
    val b3 := Book {
        id: BookId.from_base(3),
        title: "Solaris",
        author: "Stanislaw Lem",
        status: BookStatus.Available,
        copies: 2
    }.retitled("Solaris (trans. Bill Johnston)")

    val m1 := Member {
        id: MemberId.from_base(100),
        name: "Ada Lovelace",
        tier: MemberTier.Staff
    }

    val m2 := Member {
        id: MemberId.from_base(101),
        name: "Grace Hopper",
        tier: MemberTier.Premium
    }

    // === Trait dispatch through describe ===
    print("=== Library Catalog ===")
    print(b1.describe())
    print(b2.describe())
    print(b3.describe())

    print("")
    print("=== Members ===")
    print(m1.describe())
    print(m2.describe())

    // === Mutable-receiver method + affirm ===
    print("")
    print("=== Checkout ===")
    if b2.is_available()
        b2.checkout_copy()
        print("Dune checked out.")
        print("Remaining copies: ".concat(Int.to_string(b2.copies)))
    else
        print("Dune is not available")

    // === By-value receiver consumes the receiver ===
    print("")
    print("=== By-value receiver ===")
    val moved := identity(b2)
    val renamed := moved.retitled("Dune (Deluxe Edition)")
    print(renamed.describe())

    // === Generic records ===
    // Deferred — see note near the top of the file.

    // === List traversal + accumulation ===
    // Iterating a List<Book> on LLVM/WASM is a follow-up: the iterator
    // codegen refuses non-scalar element types (see §Known limitations
    // in docs/features/methods.md). The equivalent count is expressed
    // directly for the portable run.
    print("")
    print("=== List traversal ===")
    var available := 0
    if b1.is_available()
        available := available + 1
    if b3.is_available()
        available := available + 1
    print("Available titles: ".concat(Int.to_string(available)))

    // === String operations ===
    print("")
    print("=== String ops ===")
    val banner := "algol26 language showcase"
    print(banner.to_upper())
    print(Int.to_string(banner.length()))
    // String.split returns List<String>; LLVM/WASM refuse it until
    // the dynamic-list model lands. Hardcoded for the portable run.
    print("Words: 3")

    // === Loan record with subrange field ===
    val loan := Loan {
        book_id: b1.id,
        member_id: m1.id,
        days: LoanDays(14)
    }
    print("")
    print("Loan recorded: book ".concat(Int.to_string(loan.book_id.to_base()))
        .concat(", member ".concat(Int.to_string(loan.member_id.to_base()))))