// Weather Analysis System
// Demonstrates ALGOL26's Result-based try/catch.

function classify_temperature(temp: float) -> string
    if temp < 10.0 then
        return "Cold"
    if temp < 20.0 then
        return "Cool"
    if temp < 30.0 then
        return "Warm"
    return "Hot"

// Simulated fallible operation: returns Error if the input is negative.
function safe_average(a: float, b: float, c: float, d: float, e: float, f: float, g: float) -> Result<float, string>
    val sum := a + b + c + d + e + f + g
    if sum < 0.0 then
        return Error("negative sum")
    return Ok(sum / 7.0)

procedure main
    val average := try
        safe_average(18.5, 21.3, 24.7, 19.2, 27.8, 22.1, 25.6)
    catch err
        print("Could not compute average:")
        print(err)
        0.0

    print("=== Weekly Weather Report ===")

    print("Day 1: 18.5")
    print(classify_temperature(18.5))

    print("Day 2: 21.3")
    print(classify_temperature(21.3))

    print("Day 3: 24.7")
    print(classify_temperature(24.7))

    print("Day 4: 19.2")
    print(classify_temperature(19.2))

    print("Day 5: 27.8")
    print(classify_temperature(27.8))

    print("Day 6: 22.1")
    print(classify_temperature(22.1))

    print("Day 7: 25.6")
    print(classify_temperature(25.6))

    print("=== Summary ===")
    print("Average temperature:")
    print(average)
    print("Maximum temperature: 27.8")
    print("Minimum temperature: 18.5")

    print("Weather analysis finished")