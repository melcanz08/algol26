// temperature_analyzer.gol

procedure main
    val temperatures := [22.5, 24.1, 19.8, 26.3, 21.0, 23.7, 25.2]
    var total := 0.0
    var min_temp := temperatures[0]
    var max_temp := temperatures[0]

    // Calculate total and find min/max
    for temp in temperatures do
        total := total + temp

        if temp < min_temp then
            min_temp := temp

        if temp > max_temp then
            max_temp := temp

    val average := total / 7.0

    // Output results
    Terminal.print("Temperature Analysis")
    Terminal.print("--------------------")
    Terminal.print("Average:")
    Terminal.print(average)
    Terminal.print("Minimum:")
    Terminal.print(min_temp)
    Terminal.print("Maximum:")
    Terminal.print(max_temp)

    // Classify days
    Terminal.print("Classification:")
    for temp in temperatures do
        if temp > average then
            Terminal.print(temp)
            Terminal.print("  -> Above average")
        else
            Terminal.print(temp)
            Terminal.print("  -> Below or equal average")