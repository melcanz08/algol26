trait Comparable
    fn compare(other: Self) -> Int

impl Comparable for Int
    proc compare(other: Int) -> Int
        if self < other
            return -1
        else if self > other
            return 1
        else
            return 0

proc max<T>(a: T, b: T) -> T where T: Comparable
    if a.compare(b) >= 0
        return a
    else
        return b

proc main() -> Int
    val result := max(5, 10)
    print result
    return 0
