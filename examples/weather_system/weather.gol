// Weather Analysis System
// Demonstrates ALGOL26's core features

function classify_temperature(temp: float) -> string
    if temp < 10.0 then
        return "Cold"
    if temp < 20.0 then
        return "Cool"
    if temp < 30.0 then
        return "Warm"
    return "Hot"

procedure main
    try
        // Calculate average using direct values
        val average := (18.5 + 21.3 + 24.7 + 19.2 + 27.8 + 22.1 + 25.6) / 7.0
        
        // Print report
        Terminal.print("=== Weekly Weather Report ===")
        
        Terminal.print("Day 1: 18.5")
        Terminal.print(classify_temperature(18.5))
        
        Terminal.print("Day 2: 21.3")
        Terminal.print(classify_temperature(21.3))
        
        Terminal.print("Day 3: 24.7")
        Terminal.print(classify_temperature(24.7))
        
        Terminal.print("Day 4: 19.2")
        Terminal.print(classify_temperature(19.2))
        
        Terminal.print("Day 5: 27.8")
        Terminal.print(classify_temperature(27.8))
        
        Terminal.print("Day 6: 22.1")
        Terminal.print(classify_temperature(22.1))
        
        Terminal.print("Day 7: 25.6")
        Terminal.print(classify_temperature(25.6))
        
        Terminal.print("=== Summary ===")
        Terminal.print("Average temperature:")
        Terminal.print(average)
        Terminal.print("Maximum temperature: 27.8")
        Terminal.print("Minimum temperature: 18.5")
        
        // Save report
        File.write("weather_report.txt", "Weekly weather analysis complete")
        Terminal.print("Report saved!")
        
    catch err
        Terminal.print("Error:")
        Terminal.print(err)
    
    finally
        Terminal.print("Weather analysis finished")
