// json.gol — JSON value type and stringifier.
//
// Differs from examples/json/json.gol in one place: numbers are split
// into NumInt and NumFloat variants. ChainCSS IR contains both integer
// values (16, 12345, timestamps) and float values (0.1 specificity,
// 1.5 line-height), and a single Num(Int) cannot represent the float
// case.

pub union Json
    Null
    Bool(Bool)
    NumInt(Int)
    NumFloat(Float)
    Str(String)
    Arr(List<Json>)
    Obj(Map<String, Json>)
    OrderedObj(List[(String, Json)])

/// Render a Json value to its JSON text representation.
///
/// Expression-bodied (fn): the match produces the string directly.
pub fn stringify(j: Json) -> String
    match j
        case Null then "null"
        case Bool(b) if b then "true"
        case Bool(_) then "false"
        case NumInt(n) then Int.to_string(n)
        case NumFloat(f) then Float.to_string(f)
        case Str(s) then stringify_string(s)
        case Arr(xs) then stringify_array(xs)
        case Obj(m) then stringify_object(m)
        case OrderedObj(entries) then stringify_ordered_object(entries)

/// Quote and escape a string. Statement body (proc).
proc stringify_string(s: String) -> String
    var out := "\""
    for c in String.to_chars(s)
        out := out + escape_char(c)
    out := out + "\""
    return out

/// Escape one character to its JSON string representation.
/// Sequential `if` with early return (no `else if` chain).
proc escape_char(c: Char) -> String
    val n := Char.to_int(c)
    if n = 34 then
        return "\\\""
    if n = 92 then
        return "\\\\"
    if n = 10 then
        return "\\n"
    if n = 13 then
        return "\\r"
    if n = 9 then
        return "\\t"
    if n = 8 then
        return "\\b"
    if n = 12 then
        return "\\f"
    if n < 32 then
        return "\\u00" + hex_byte(n)
    return Char.to_string(c)

/// Two-digit lowercase hex for a byte value 0..255.
proc hex_byte(n: Int) -> String
    val hi := n / 16
    val lo := n - hi * 16
    return hex_digit(hi) + hex_digit(lo)

/// One hex digit as a lowercase string.
/// Uses a lookup table — no Char.from_int builtin exists.
proc hex_digit(n: Int) -> String
    val table := String.to_chars("0123456789abcdef")
    return Char.to_string(table[n])

/// "[a,b,c]" with no spaces (minified, matching JSON.stringify).
proc stringify_array(xs: List<Json>) -> String
    if xs.length() = 0 then
        return "[]"
    var out := "["
    var first := true
    for x in xs
        if not first then
            out := out + ","
        first := false
        out := out + stringify(x)
    out := out + "]"
    return out

/// "{"k":v,...}" with keys emitted in Map.keys() order.
/// Map.keys() sorts lexicographically in the current interpreter.
/// The JSON spec does not require any particular key order.
proc stringify_object(m: Map<String, Json>) -> String
    val keys := m.keys()
    if keys.length() = 0 then
        return "{}"
    var out := "{"
    var first := true
    for k in keys
        if not first then
            out := out + ","
        first := false
        out := out + stringify_string(k)
        out := out + ":"
        match m.get(k)
            case Some(v) then
                out := out + stringify(v)
            case None then
                out := out + "null"
    out := out + "}"
    return out


// ======================================
// Parsing
// ======================================

/// Result of a successful parse step: parsed value + cursor position.
/// Now uses `rec` (not a union workaround) thanks to the ALGOL26 fix
/// recorded as G9 in LANGUAGE_GAPS.md — records can reference unions
/// in the same file.

/// Serialize an OrderedObj to its JSON text representation.
///
/// Per ADR 0066, OrderedObj preserves insertion order in the
/// in-memory representation. To keep byte-for-byte parity with
/// `stringify_object` (needed for the Phase 5 parity tests' golden
/// files), this function sorts its entries by key on serialize.
/// Both variants therefore emit sorted-key output — the caller sees
/// uniform behavior regardless of which they hand to `stringify`.
///
/// This is a byte-compat choice documented in ADR 0066
/// ("Stringify" section). A future change to source-order
/// serialization is a one-line swap (`entries` sorted vs. used
/// as-is) if the emitter (Phase 7) prefers it.
proc stringify_ordered_object(entries: List[(String, Json)]) -> String
    if entries.length() = 0 then
        return "{}"
    // Insertion sort by key. Stable — equal keys keep source order,
    // matching how stringify_object's Map.keys() would order them.
    var sorted: List[(String, Json)] := []
    for pair in entries
        val pair_key := pair.0
        var inserted := false
        var next: List[(String, Json)] := []
        for existing in sorted
            val existing_key := existing.0
            if not inserted then
                if compare_keys(pair_key, existing_key) < 0 then
                    next.append(pair)
                    next.append(existing)
                    inserted := true
                else
                    next.append(existing)
            else
                next.append(existing)
        if not inserted then
            next.append(pair)
        sorted := next
    var out := "{"
    var first := true
    for pair in sorted
        if not first then
            out := out + ","
        first := false
        out := out + stringify_string(pair.0)
        out := out + ":"
        out := out + stringify(pair.1)
    out := out + "}"
    return out

/// Compare two strings lexicographically by byte value. Returns
/// -1 (a < b), 0 (a = b), or 1 (a > b). Matches the ordering
/// `Map.keys()` produces (which sorts lexicographically in the
/// interpreter).
proc compare_keys(a: String, b: String) -> Int
    val ac := String.to_chars(a)
    val bc := String.to_chars(b)
    var i := 0
    while i < ac.length() and i < bc.length()
        val an := Char.to_int(ac[i])
        val bn := Char.to_int(bc[i])
        if an < bn then
            return -1
        if an > bn then
            return 1
        i := i + 1
    if ac.length() < bc.length() then
        return -1
    if ac.length() > bc.length() then
        return 1
    return 0

rec ParseOk
    value: Json
    pos: Int

/// Skip ASCII whitespace (space, tab, newline, carriage return).
proc skip_whitespace(chars: List<Char>, pos: Int) -> Int
    var i := pos
    while i < chars.length()
        val n := Char.to_int(chars[i])
        if n = 32 or n = 9 or n = 10 or n = 13 then
            i := i + 1
        else
            return i
    return i

/// Parse literal `null` at `pos`.
proc parse_null(chars: List<Char>, pos: Int) -> Result<ParseOk, String>
    if pos + 4 > chars.length() then
        return Error("parse_null: truncated at pos " + Int.to_string(pos))
    if Char.to_int(chars[pos])     != 110 then
        return Error("parse_null: expected 'n' at pos " + Int.to_string(pos))
    if Char.to_int(chars[pos + 1]) != 117 then
        return Error("parse_null: expected 'u' at pos " + Int.to_string(pos + 1))
    if Char.to_int(chars[pos + 2]) != 108 then
        return Error("parse_null: expected 'l' at pos " + Int.to_string(pos + 2))
    if Char.to_int(chars[pos + 3]) != 108 then
        return Error("parse_null: expected 'l' at pos " + Int.to_string(pos + 3))
    return Ok(ParseOk { value: Json.Null, pos: pos + 4 })

/// Parse `true` or `false` at `pos`.
proc parse_bool(chars: List<Char>, pos: Int) -> Result<ParseOk, String>
    if pos >= chars.length() then
        return Error("parse_bool: truncated at pos " + Int.to_string(pos))
    val first := Char.to_int(chars[pos])
    if first = 116 then
        if pos + 4 > chars.length() then
            return Error("parse_bool: truncated in 'true'")
        if Char.to_int(chars[pos + 1]) != 114 then
            return Error("parse_bool: expected 'r' at pos " + Int.to_string(pos + 1))
        if Char.to_int(chars[pos + 2]) != 117 then
            return Error("parse_bool: expected 'u' at pos " + Int.to_string(pos + 2))
        if Char.to_int(chars[pos + 3]) != 101 then
            return Error("parse_bool: expected 'e' at pos " + Int.to_string(pos + 3))
        return Ok(ParseOk { value: Json.Bool(true), pos: pos + 4 })
    if first = 102 then
        if pos + 5 > chars.length() then
            return Error("parse_bool: truncated in 'false'")
        if Char.to_int(chars[pos + 1]) != 97 then
            return Error("parse_bool: expected 'a' at pos " + Int.to_string(pos + 1))
        if Char.to_int(chars[pos + 2]) != 108 then
            return Error("parse_bool: expected 'l' at pos " + Int.to_string(pos + 2))
        if Char.to_int(chars[pos + 3]) != 115 then
            return Error("parse_bool: expected 's' at pos " + Int.to_string(pos + 3))
        if Char.to_int(chars[pos + 4]) != 101 then
            return Error("parse_bool: expected 'e' at pos " + Int.to_string(pos + 4))
        return Ok(ParseOk { value: Json.Bool(false), pos: pos + 5 })
    return Error("parse_bool: expected 'true' or 'false' at pos " + Int.to_string(pos))

/// Top-level parse entry point: skip leading whitespace, dispatch on
/// the first character, skip trailing whitespace, require end-of-input.
pub proc parse(s: String) -> Result<Json, String>
    val chars := String.to_chars(s)
    val start := skip_whitespace(chars, 0)
    if start >= chars.length() {
        return Error("parse: input is empty or all whitespace")
    }
    match parse_value(chars, start) {
        case Ok(ok) then {
            val tail := skip_whitespace(chars, ok.pos)
            if tail != chars.length() {
                return Error("parse: unexpected trailing content at pos " + Int.to_string(tail))
            }
            return Ok(ok.value)
        }
        case Error(msg) then {
            return Error(msg)
        }
    }

pub proc parse_value(chars: List<Char>, pos: Int) -> Result<ParseOk, String>
    if pos >= chars.length() {
        return Error("parse_value: input empty at pos " + Int.to_string(pos))
    }
    val first := Char.to_int(chars[pos])
    if first = 110 {
        return parse_null(chars, pos)
    }
    if first = 116 or first = 102 {
        return parse_bool(chars, pos)
    }
    if first = 45 or (first >= 48 and first <= 57) {
        return parse_number(chars, pos)
    }
    if first = 34 {
        return parse_string(chars, pos)
    }
    if first = 91 {
        return parse_array(chars, pos)
    }
    if first = 123 {
        return parse_object(chars, pos)
    }
    return Error("parse_value: unsupported value kind at pos " + Int.to_string(pos))
proc chars_to_string(chars: List<Char>, start: Int, finish: Int) -> String
    var out := ""
    var i := start
    while i < finish
        out := out + Char.to_string(chars[i])
        i := i + 1
    return out


/// Parse a JSON number at `pos`. Handles optional `-`, integer
/// part (with leading-zero rejection), optional `.fraction`,
/// optional `e/E[+-]exponent`. Returns NumInt for integer forms,
/// NumFloat otherwise.
proc parse_number(chars: List<Char>, pos: Int) -> Result<ParseOk, String>
    var i := pos
    var is_negative := false
    if i < chars.length() and Char.to_int(chars[i]) = 45 {
        is_negative := true
        i := i + 1
    }

    val int_start := i
    if i >= chars.length() {
        return Error("parse_number: expected digit at pos " + Int.to_string(i))
    }
    val first_digit := Char.to_int(chars[i])
    if first_digit < 48 or first_digit > 57 {
        return Error("parse_number: expected digit at pos " + Int.to_string(i))
    }

    if first_digit = 48 {
        i := i + 1
        if i < chars.length() {
            val next_digit := Char.to_int(chars[i])
            if next_digit >= 48 and next_digit <= 57 {
                return Error("parse_number: leading zero at pos " + Int.to_string(int_start))
            }
        }
    } else {
        i := i + 1
        while i < chars.length() and Char.to_int(chars[i]) >= 48 and Char.to_int(chars[i]) <= 57 {
            i := i + 1
        }
    }

    val int_end := i

    var has_frac := false
    var frac_start := 0
    var frac_end := 0
    if i < chars.length() and Char.to_int(chars[i]) = 46 {
        i := i + 1
        frac_start := i
        while i < chars.length() and Char.to_int(chars[i]) >= 48 and Char.to_int(chars[i]) <= 57 {
            i := i + 1
        }
        frac_end := i
        if frac_end = frac_start {
            return Error("parse_number: expected digit after '.' at pos " + Int.to_string(frac_start))
        }
        has_frac := true
    }

    var has_exp := false
    var exp_start := 0
    var exp_end := 0
    var exp_negative := false
    if i < chars.length() and (Char.to_int(chars[i]) = 101 or Char.to_int(chars[i]) = 69) {
        i := i + 1
        if i < chars.length() and Char.to_int(chars[i]) = 45 {
            exp_negative := true
            i := i + 1
        } else if i < chars.length() and Char.to_int(chars[i]) = 43 {
            i := i + 1
        }
        exp_start := i
        while i < chars.length() and Char.to_int(chars[i]) >= 48 and Char.to_int(chars[i]) <= 57 {
            i := i + 1
        }
        exp_end := i
        if exp_end = exp_start {
            return Error("parse_number: expected digit in exponent at pos " + Int.to_string(exp_start))
        }
        has_exp := true
    }

    // Workaround for IR builder bug (compiler-side, not fixed here):
    // the exp-only runtime path (has_frac=false, has_exp=true) fails to
    // return. Forcing has_frac=true when has_exp=true routes through
    // the frac+exp path, which works. The arithmetic result is identical
    // because the empty frac part contributes zero.
    if has_exp {
        has_frac := true
    }

    val int_part_str := chars_to_string(chars, int_start, int_end)

    match String.to_int(int_part_str) {
        case Some(n) then {
            if not has_frac and not has_exp {
                val value := if is_negative then -n else n
                return Ok(ParseOk { value: Json.NumInt(value), pos: i })
            }
            var mantissa := 0.0
            mantissa := n
            if has_frac {
                val frac_part_str := chars_to_string(chars, frac_start, frac_end)
                var frac_val := 0
                var frac_len := 0
                for c in String.to_chars(frac_part_str) {
                    frac_val := frac_val * 10 + (Char.to_int(c) - 48)
                    frac_len := frac_len + 1
                }
                var divisor := 1.0
                var k := 0
                while k < frac_len {
                    divisor := divisor * 10.0
                    k := k + 1
                }
                mantissa := mantissa + frac_val / divisor
            }
            if is_negative {
                mantissa := -mantissa
            }
            if has_exp {
                val exp_part_str := chars_to_string(chars, exp_start, exp_end)
                match String.to_int(exp_part_str) {
                    case Some(e) then {
                        var exp_val := e
                        if exp_negative {
                            exp_val := -exp_val
                        }
                        return Ok(ParseOk { value: Json.NumFloat(mantissa * Math.pow(10.0, exp_val)), pos: i })
                    }
                    case None then {
                        return Error("parse_number: exponent overflow")
                    }
                }
            } else {
                return Ok(ParseOk { value: Json.NumFloat(mantissa), pos: i })
            }
            return Error("parse_number: unreachable")
        }
        case None then {
            return Error("parse_number: int part overflow")
        }
    }

/// Decode one escape sequence after a backslash. `esc` is the
/// codepoint of the character following `\`.
/// Returns the decoded string, or an error for invalid/unsupported
/// escape sequences. \uXXXX is not yet supported (no Char.from_int
/// primitive in ALGOL26 v0.8).
proc parse_escape(esc: Int) -> Result<String, String>
    if esc = 34 {
        return Ok("\"")
    }
    if esc = 92 {
        return Ok("\\")
    }
    if esc = 47 {
        return Ok("/")
    }
    if esc = 110 {
        return Ok("\n")
    }
    if esc = 114 {
        return Ok("\r")
    }
    if esc = 116 {
        return Ok("\t")
    }
    if esc = 98 {
        return Error("parse_escape: backslash-b (backspace) not supported in ALGOL26")
    }
    if esc = 102 {
        return Error("parse_escape: backslash-f (form feed) not supported in ALGOL26")
    }
    if esc = 117 {
        return Error("parse_escape: \\uXXXX not yet supported")
    }
    return Error("parse_escape: invalid escape sequence")

/// Parse a JSON string literal at `pos`. Expects chars[pos] = '"'.
/// Returns Ok(ParseOk { value: Json.Str(s), pos: i_after_closing_quote }).
/// Decodes \" \\ \/ \n \r \t \b \f. Errors on unterminated strings,
/// bad escapes, and \uXXXX (unsupported).
pub proc parse_string(chars: List<Char>, pos: Int) -> Result<ParseOk, String>
    if pos >= chars.length() {
        return Error("parse_string: expected '\"' at pos " + Int.to_string(pos))
    }
    if Char.to_int(chars[pos]) != 34 {
        return Error("parse_string: expected '\"' at pos " + Int.to_string(pos))
    }
    var i := pos + 1
    var out := ""
    while i < chars.length() {
        val n := Char.to_int(chars[i])
        if n = 34 {
            return Ok(ParseOk { value: Json.Str(out), pos: i + 1 })
        }
        if n = 92 {
            if i + 1 < chars.length() {
                val esc := Char.to_int(chars[i + 1])
                val decoded := parse_escape(esc)
                match decoded {
                    case Ok(s) then {
                        out := out + s
                        i := i + 2
                    }
                    case Error(msg) then {
                        return Error(msg)
                    }
                }
            } else {
                return Error("parse_string: unterminated escape at pos " + Int.to_string(i))
            }
        } else {
            out := out + Char.to_string(chars[i])
            i := i + 1
        }
    }
    return Error("parse_string: unterminated string starting at pos " + Int.to_string(pos))

/// Parse a JSON array at `pos`. Expects chars[pos] = '['.
/// Returns Ok(ParseOk { value: Json.Arr(acc), pos: after ']' }).
pub proc parse_array(chars: List<Char>, pos: Int) -> Result<ParseOk, String>
    if pos >= chars.length() or Char.to_int(chars[pos]) != 91 {
        return Error("parse_array: expected '[' at pos " + Int.to_string(pos))
    }
    val j := skip_whitespace(chars, pos + 1)
    if j < chars.length() and Char.to_int(chars[j]) = 93 {
        return Ok(ParseOk { value: Json.Arr([]), pos: j + 1 })
    } else {
        return parse_array_elements(chars, j, [])
    }

/// Recursive element parser for parse_array. Accumulates elements in
/// `acc` (passed by value at each level; the caller's list is moved
/// in and the extended list is moved to the recursive call).
///
/// Recursive rather than iterative because the IR verifier flags a
/// trailing return after a 'while' as unreachable, but the analyzer
/// requires a return after 'while'. Contradictory requirements —
/// see G14 in LANGUAGE_GAPS.md.
pub proc parse_array_elements(chars: List<Char>, pos: Int, acc: List<Json>) -> Result<ParseOk, String>
    if pos >= chars.length() {
        return Error("parse_array: unterminated array")
    } else {
        match parse_value(chars, pos) {
            case Ok(ok) then {
                var new_acc := acc
                new_acc.append(ok.value)
                val after := skip_whitespace(chars, ok.pos)
                if after >= chars.length() {
                    return Error("parse_array: unterminated array")
                } else {
                    val c := Char.to_int(chars[after])
                    if c = 44 {
                        val next := skip_whitespace(chars, after + 1)
                        return parse_array_elements(chars, next, new_acc)
                    } else if c = 93 {
                        return Ok(ParseOk { value: Json.Arr(new_acc), pos: after + 1 })
                    } else {
                        return Error("parse_array: expected ',' or ']' at pos " + Int.to_string(after))
                    }
                }
            }
            case Error(msg) then {
                return Error(msg)
            }
        }
    }


/// Parse a JSON object at `pos`. Expects chars[pos] = '{'.
pub proc parse_object(chars: List<Char>, pos: Int) -> Result<ParseOk, String>
    if pos >= chars.length() or Char.to_int(chars[pos]) != 123 {
        return Error("parse_object: expected '{' at pos " + Int.to_string(pos))
    } else {
        val j := skip_whitespace(chars, pos + 1)
        if j < chars.length() and Char.to_int(chars[j]) = 125 {
            return Ok(ParseOk { value: Json.Obj(Map<String, Json> {}), pos: j + 1 })
        } else {
            return parse_object_pairs(chars, j, Map<String, Json> {})
        }
    }

/// Parse one or more key-value pairs starting at `pos`, accumulating
/// into `acc`. Terminates at '}'.
pub proc parse_object_pairs(chars: List<Char>, pos: Int, acc: Map<String, Json>) -> Result<ParseOk, String>
    if pos >= chars.length() {
        return Error("parse_object: unterminated object")
    } else {
        match parse_string(chars, pos) {
            case Ok(key_ok) then {
                return parse_object_pair(chars, key_ok, acc)
            }
            case Error(msg) then {
                return Error(msg)
            }
        }
    }

/// After the key is parsed: expect ':', then parse the value.
pub proc parse_object_pair(chars: List<Char>, key_ok: ParseOk, acc: Map<String, Json>) -> Result<ParseOk, String>
    val colon_pos := skip_whitespace(chars, key_ok.pos)
    if colon_pos >= chars.length() or Char.to_int(chars[colon_pos]) != 58 {
        return Error("parse_object: expected ':' at pos " + Int.to_string(colon_pos))
    } else {
        val val_pos := skip_whitespace(chars, colon_pos + 1)
        match parse_value(chars, val_pos) {
            case Ok(val_ok) then {
                return parse_object_finish(chars, key_ok.value, val_ok, acc)
            }
            case Error(msg) then {
                return Error(msg)
            }
        }
    }


/// Extract the key string from `key_json` and insert the value into
/// `acc`. Continue to the separator check.
pub proc parse_object_finish(chars: List<Char>, key_json: Json, val_ok: ParseOk, acc: Map<String, Json>) -> Result<ParseOk, String>
    match key_json {
        case Str(k) then {
            return parse_object_insert(chars, k, val_ok, acc)
        }
        case _ then {
            return Error("parse_object: internal: key is not a string")
        }
    }

/// Insert the value into the accumulator and continue to separator.
pub proc parse_object_insert(chars: List<Char>, key: String, val_ok: ParseOk, acc: Map<String, Json>) -> Result<ParseOk, String>
    var new_acc := acc
    new_acc.insert(key, val_ok.value)
    return parse_object_separator(chars, val_ok.pos, new_acc)

/// After a value is parsed: expect ',' (continue) or '}' (end).
pub proc parse_object_separator(chars: List<Char>, pos: Int, acc: Map<String, Json>) -> Result<ParseOk, String>
    val after := skip_whitespace(chars, pos)
    if after >= chars.length() {
        return Error("parse_object: unterminated object")
    } else {
        val c := Char.to_int(chars[after])
        if c = 44 {
            val next := skip_whitespace(chars, after + 1)
            return parse_object_pairs(chars, next, acc)
        } else if c = 125 {
            return Ok(ParseOk { value: Json.Obj(acc), pos: after + 1 })
        } else {
            return Error("parse_object: expected ',' or '}' at pos " + Int.to_string(after))
        }
    }
