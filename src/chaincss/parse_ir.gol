// parse_ir.gol — port of parseIR from TS parser.ts, Phase 2D.
//
// Handles paths exercised by the three buildable corpus entries
// (001-card, 002-button, 003-lenient-passthrough).
//
// Deferred (no-op on corpus): atRules, _nestedRules, _intents,
// _ifConditions, dynamic tokens, function values, plain-object values.
//
// Port structure now matches the TypeScript source: nested matches
// on the Json union work at arbitrary depth (G18), and &mut IRRule /
// &mut StyleIR thread through the dispatch chain directly (G19a/b/c).
// No helper cascade, no -> IRRule threading.

import "json.gol"
import "ir_types.gol"
import "ir_factory.gol"
import "parser.gol"

// ============================================================================
// make_empty_ir — construct a fresh StyleIR
// ============================================================================

proc make_empty_ir(source_file: String) -> StyleIR
    var source_files: List[String] := []
    if source_file.length() > 0 {
        source_files.append(source_file)
    }
    val meta := StyleIRMeta {
        version: "0.0.0",
        createdAt: 0,
        sourceFiles: source_files,
        passCount: 0,
        passes: [],
        dirtyRules: 0,
        compiledAt: 0
    }
    return StyleIR {
        id: "ir-0",
        rules: [],
        atRules: [],
        diagnostics: [],
        meta: meta,
        graph: None
    }

// ============================================================================
// extract_selectors — Arr<Str> / Str / fallback [.<component>]
// ============================================================================

proc extract_selectors(map: Map<String, Json>, component_name: String) -> List<String>
    match map.get("selectors") {
        case Some(v) then {
            match v {
                case Arr(items) then {
                    var out: List<String> := []
                    for item in items {
                        match item {
                            case Str(s) then { out.append(s) }
                            case _ then {}
                        }
                    }
                    return out
                }
                case Str(s) then {
                    var out: List<String> := []
                    out.append(s)
                    return out
                }
                case _ then {
                    var out: List<String> := []
                    out.append("." + component_name)
                    return out
                }
            }
        }
        case None then {
            match map.get("selector") {
                case Some(sv) then {
                    match sv {
                        case Str(s) then {
                            var out: List<String> := []
                            out.append(s)
                            return out
                        }
                        case _ then {
                            var out: List<String> := []
                            out.append("." + component_name)
                            return out
                        }
                    }
                }
                case None then {
                    var out: List<String> := []
                    out.append("." + component_name)
                    return out
                }
            }
        }
    }

// ============================================================================
// is_reserved_property
// ============================================================================

proc is_reserved_property(key: String) -> Bool
    if key = "selectors" { return true }
    if key = "selector" { return true }
    if key = "atRules" { return true }
    if key = "nestedRules" { return true }
    if key = "themes" { return true }
    if starts_with(key, "_") { return true }
    return false

// ============================================================================
// handle_pseudo_class — &:hover / &::before
// ============================================================================

proc handle_pseudo_class(
    prop: String,
    value: Json,
    rule: &mut IRRule,
    source: Option[SourceLocation]
) -> Void
    val is_element := starts_with(prop, "&::")
    var pseudo_name := ""
    if is_element {
        pseudo_name := String.substring(prop, 3, prop.length() - 3)
    } else {
        pseudo_name := String.substring(prop, 2, prop.length() - 2)
    }
    var pseudo_full_name := ""
    if is_element {
        pseudo_full_name := "::" + pseudo_name
    } else {
        pseudo_full_name := pseudo_name
    }
    val parent_id := rule.id
    var source_value := SourceLocation {
        file: None,
        line: None,
        column: None,
        component: None
    }
    match source {
        case Some(sl) then { source_value := sl }
        case None then {}
    }
    var pc := IRPseudoClass {
        id: pseudo_full_name + "-" + rule.selector,
        parentId: parent_id,
        name: pseudo_full_name,
        declarations: [],
        source: source_value,
        history: [make_transform_record("parser", "created", "Parsed " + pseudo_name)]
    }
    match value {
        case Obj(map) then {
            for key in map.keys() {
                match map.get(key) {
                    case Some(v) then {
                        match v {
                            case Str(_) then {
                                pc.declarations.append(
                                    create_declaration(normalize_property(key), v, source, rule.selector)
                                )
                            }
                            case NumInt(_) then {
                                pc.declarations.append(
                                    create_declaration(normalize_property(key), v, source, rule.selector)
                                )
                            }
                            case NumFloat(_) then {
                                pc.declarations.append(
                                    create_declaration(normalize_property(key), v, source, rule.selector)
                                )
                            }
                            case Arr(items) then {
                                for item in items {
                                    match item {
                                        case Str(_) then {
                                            pc.declarations.append(
                                                create_declaration(normalize_property(key), item, source, rule.selector)
                                            )
                                        }
                                        case NumInt(_) then {
                                            pc.declarations.append(
                                                create_declaration(normalize_property(key), item, source, rule.selector)
                                            )
                                        }
                                        case NumFloat(_) then {
                                            pc.declarations.append(
                                                create_declaration(normalize_property(key), item, source, rule.selector)
                                            )
                                        }
                                        case _ then {}
                                    }
                                }
                            }
                            case Obj(inner_map) then {
                                for inner_key in inner_map.keys() {
                                    match inner_map.get(inner_key) {
                                        case Some(inner_v) then {
                                            val pn := if inner_key = "color" and key = "background" {
                                                "backgroundColor"
                                            } else {
                                                inner_key
                                            }
                                            match inner_v {
                                                case Str(_) then {
                                                    pc.declarations.append(
                                                        create_declaration(normalize_property(pn), inner_v, source, rule.selector)
                                                    )
                                                }
                                                case NumInt(_) then {
                                                    pc.declarations.append(
                                                        create_declaration(normalize_property(pn), inner_v, source, rule.selector)
                                                    )
                                                }
                                                case NumFloat(_) then {
                                                    pc.declarations.append(
                                                        create_declaration(normalize_property(pn), inner_v, source, rule.selector)
                                                    )
                                                }
                                                case _ then {}
                                            }
                                        }
                                        case None then {}
                                    }
                                }
                            }
                            case _ then {}
                        }
                    }
                    case None then {}
                }
            }
        }
        case _ then {}
    }
    if pc.declarations.length() > 0 {
        rule.pseudoClasses.append(pc)
    }

// ============================================================================
// parse_rule_for_selector — one rule per selector
// ============================================================================

proc parse_rule_for_selector(
    style_map: Map<String, Json>,
    selector: String,
    source: SourceLocation,
    ir: &mut StyleIR
) -> Void
    var rule := create_rule(selector, Some(source), None)
    for key in style_map.keys() {
        if not is_reserved_property(key) {
            match style_map.get(key) {
                case Some(v) then {
                    if starts_with(key, "&:") or starts_with(key, "&::") {
                        match v {
                            case Obj(_) then { handle_pseudo_class(key, v, &mut rule, Some(source)) }
                            case _ then {}
                        }
                    } else if starts_with(key, "&") {
                        match v {
                            case Obj(_) then {
                                val nested_selector := replace_all(key, "&", rule.selector)
                                var nested := create_rule(nested_selector, Some(source), Some(rule.id))
                                parse_nested_object(nested_selector, v, &mut nested, Some(source))
                                rule.nestedRules.append(nested)
                            }
                            case _ then {}
                        }
                    } else {
                        match v {
                            case Str(_) then {
                                rule.declarations.append(
                                    create_declaration(normalize_property(key), v, Some(source), rule.selector)
                                )
                            }
                            case NumInt(_) then {
                                rule.declarations.append(
                                    create_declaration(normalize_property(key), v, Some(source), rule.selector)
                                )
                            }
                            case NumFloat(_) then {
                                rule.declarations.append(
                                    create_declaration(normalize_property(key), v, Some(source), rule.selector)
                                )
                            }
                            case Arr(items) then {
                                for item in items {
                                    match item {
                                        case Str(_) then {
                                            rule.declarations.append(
                                                create_declaration(normalize_property(key), item, Some(source), rule.selector)
                                            )
                                        }
                                        case NumInt(_) then {
                                            rule.declarations.append(
                                                create_declaration(normalize_property(key), item, Some(source), rule.selector)
                                            )
                                        }
                                        case NumFloat(_) then {
                                            rule.declarations.append(
                                                create_declaration(normalize_property(key), item, Some(source), rule.selector)
                                            )
                                        }
                                        case _ then {}
                                    }
                                }
                            }
                            case _ then {}
                        }
                    }
                }
                case None then {}
            }
        }
    }
    ir.rules.append(rule)

// ============================================================================
// parse_one_component — one component's style map
// ============================================================================

proc parse_one_component(
    cv: Json,
    component_name: String,
    source_file: String,
    ir: &mut StyleIR
) -> Void
    match cv {
        case Obj(style_map) then {
            val selectors := extract_selectors(style_map, component_name)
            val source := SourceLocation {
                file: Some(source_file),
                line: None,
                column: None,
                component: Some(component_name)
            }
            for selector in selectors {
                parse_rule_for_selector(style_map, selector, source, ir)
            }
        }
        case _ then {}
    }

// ============================================================================
// parse_components — top-level dispatch over the component map
// ============================================================================

proc parse_components(
    components: Map<String, Json>,
    source_file: String,
    ir: &mut StyleIR
) -> Void
    for component_name in components.keys() {
        match components.get(component_name) {
            case Some(cv) then {
                parse_one_component(cv, component_name, source_file, ir)
            }
            case None then {}
        }
    }

// ============================================================================
// parse_ir — top-level entry, matches the TS parseIR shape
// ============================================================================

pub proc parse_ir(styles: Json, source_file: String) -> StyleIR
    var ir := make_empty_ir(source_file)
    match styles {
        case Obj(components) then {
            parse_components(components, source_file, &mut ir)
        }
        case _ then {}
    }
    return ir
