

// ============================================================================
// Phase 2B — pure functions from parser.ts
// ============================================================================

/// True iff `s` starts with `prefix`.
import "json.gol"
import "ir_types.gol"
import "ir_factory.gol"

pub proc starts_with(s: String, prefix: String) -> Bool
    if prefix.length() > s.length() {
        return false
    } else {
        val s_chars := String.to_chars(s)
        val p_chars := String.to_chars(prefix)
        var i := 0
        var ok := true
        while i < p_chars.length() and ok {
            if Char.to_int(s_chars[i]) != Char.to_int(p_chars[i]) {
                ok := false
            }
            i := i + 1
        }
        return ok
    }

/// True iff `s` contains `needle` as a substring.
pub proc contains(s: String, needle: String) -> Bool
    if needle.length() > s.length() {
        return false
    } else {
        if needle.length() = 0 {
            return true
        } else {
            val sc := String.to_chars(s)
            val nc := String.to_chars(needle)
            var i := 0
            var found := false
            while i + nc.length() <= sc.length() and not found {
                var j := 0
                var match_here := true
                while j < nc.length() and match_here {
                    if Char.to_int(sc[i + j]) != Char.to_int(nc[j]) {
                        match_here := false
                    }
                    j := j + 1
                }
                if match_here {
                    found := true
                }
                i := i + 1
            }
            return found
        }
    }

/// True iff char (as codepoint) is a letter A-Z.
proc is_upper_letter(n: Int) -> Bool
    if n >= 65 and n <= 90 {
        return true
    } else {
        return false
    }

/// Camel-case to kebab-case with lowercasing, as one pass.
/// Inserts '-' before each uppercase letter and lowercases everything.
pub proc kebab_lower(s: String) -> String
    val orig := String.to_chars(s)
    val lower := String.to_chars(String.to_lower(s))
    var out := ""
    var i := 0
    while i < orig.length() {
        val n := Char.to_int(orig[i])
        if n >= 65 and n <= 90 {
            out := out + "-" + Char.to_string(lower[i])
        } else {
            out := out + Char.to_string(lower[i])
        }
        i := i + 1
    }
    return out

/// normalizeProperty from parser.ts:
///   --*      -> unchanged (CSS custom properties)
///   no [A-Z] -> unchanged
///   ms[A-Z] or [A-Z] start -> kebab + leading dash
///   else kebab
pub proc normalize_property(prop: String) -> String
    if starts_with(prop, "--") {
        return prop
    } else {
        // Check for any uppercase letter in prop
        val chars := String.to_chars(prop)
        var has_upper := false
        var i := 0
        while i < chars.length() and not has_upper {
            if is_upper_letter(Char.to_int(chars[i])) {
                has_upper := true
            }
            i := i + 1
        }
        if not has_upper {
            return prop
        } else {
            // needsLeadingDash: /^[A-Z]/ OR /^ms[A-Z]/
            val first_n := Char.to_int(chars[0])
            var needs_leading_dash := is_upper_letter(first_n)
            if not needs_leading_dash and chars.length() >= 3 {
                val c0 := Char.to_int(chars[0])
                val c1 := Char.to_int(chars[1])
                val c2 := Char.to_int(chars[2])
                if c0 = 109 and c1 = 115 and is_upper_letter(c2) {
                    needs_leading_dash := true
                }
            }
            val kebabed := kebab_lower(prop)
            if not needs_leading_dash {
                return kebabed
            } else {
                if starts_with(kebabed, "-") {
                    return kebabed
                } else {
                    return "-" + kebabed
                }
            }
        }
    }


/// True iff `n` (codepoint) is a valid identifier character:
/// [a-zA-Z0-9_$].
proc is_identifier_char(n: Int) -> Bool
    if n >= 65 and n <= 90 {
        return true
    }
    if n >= 97 and n <= 122 {
        return true
    }
    if n >= 48 and n <= 57 {
        return true
    }
    if n = 95 {
        return true
    }
    if n = 36 {
        return true
    }
    return false

/// True iff `n` (codepoint) can start an identifier: [a-zA-Z_$].
proc is_identifier_start(n: Int) -> Bool
    if n >= 65 and n <= 90 {
        return true
    }
    if n >= 97 and n <= 122 {
        return true
    }
    if n = 95 {
        return true
    }
    if n = 36 {
        return true
    }
    return false

/// True iff `s` matches the token path grammar:
///   segment ('.' segment)*
/// where segment = [a-zA-Z_$][a-zA-Z0-9_$]*.
/// Used to validate `theme.*` and `props.*` paths.
pub proc is_valid_token_path(s: String) -> Bool
    if s.length() = 0 {
        return false
    } else {
        val chars := String.to_chars(s)
        var segments: List[String] := []
        var current := ""
        for c in chars {
            if Char.to_int(c) = 46 {
                segments.append(current)
                current := ""
            } else {
                current := current + Char.to_string(c)
            }
        }
        segments.append(current)
        var all_valid := true
        for seg in segments {
            if seg.length() = 0 {
                all_valid := false
            }
        }
        if not all_valid {
            return false
        } else {
            var i := 0
            var ok := true
            while i < segments.length() and ok {
                val seg_chars := String.to_chars(segments[i])
                if not is_identifier_start(Char.to_int(seg_chars[0])) {
                    ok := false
                } else {
                    var j := 1
                    while j < seg_chars.length() and ok {
                        if not is_identifier_char(Char.to_int(seg_chars[j])) {
                            ok := false
                        }
                        j := j + 1
                    }
                }
                i := i + 1
            }
            return ok
        }
    }

/// True iff the string contains a `${` that is NOT inside a pair of
/// matched quotes. Matches parser.ts's QUOTED_DOLLAR_BRACE regex:
///   /(['"])(?:(?!).)*\$\{(?:(?!\1).)*\1/
/// i.e. a `${` between a matched pair of quote characters.
///
/// Note: this returns true only when `${` is inside matched quotes.
/// The function name matches the TS regex's variable name, which
/// (confusingly) captures the "is quoted" case, not the "is unquoted"
/// case.
pub proc has_quoted_dollar_brace(s: String) -> Bool
    val chars := String.to_chars(s)
    var i := 0
    while i < chars.length() {
        val n := Char.to_int(chars[i])
        if n = 34 or n = 39 {
            val quote := n
            var j := i + 1
            var found_close := false
            var found_dollar_brace := false
            while j < chars.length() and not found_close {
                val cj := Char.to_int(chars[j])
                if cj = quote {
                    found_close := true
                } else if cj = 36 and j + 1 < chars.length() and Char.to_int(chars[j + 1]) = 123 {
                    found_dollar_brace := true
                }
                j := j + 1
            }
            if found_close and found_dollar_brace {
                return true
            }
            i := j
        } else {
            i := i + 1
        }
    }
    return false

/// isDynamicToken from parser.ts:
///   contains unquoted "${"               -> dynamic
///   starts with "theme." and valid path   -> dynamic
///   starts with "props." and valid path   -> dynamic
///   otherwise                             -> static
pub proc is_dynamic_token(value: String) -> Bool
    if contains(value, "${") and not has_quoted_dollar_brace(value) {
        return true
    }
    if starts_with(value, "theme.") and is_valid_token_path(value) {
        return true
    }
    if starts_with(value, "props.") and is_valid_token_path(value) {
        return true
    }
    return false


// ============================================================================
// List<Json> helpers — factor nested match out of match (G18 workaround)
// ============================================================================
//
// G18 (analyzer bug): `match` on a union value inside another `match`
// arm loses the union's variant table. Workaround: extract the inner
// match into a top-level helper. The helpers below have `match item`
// at depth 1, which resolves correctly.

/// Extract string elements from a List<Json>. Used by extract_selectors.
pub proc collect_string_items(items: List<Json>) -> List<String>
    var out: List<String> := []
    var idx := 0
    while idx < items.length() {
        val item := items[idx]
        match item {
            case Str(s) then { out.append(s) }
            case _ then {}
        }
        idx := idx + 1
    }
    return out

/// Append IRDeclarations built from string/number elements of a
/// List<Json> to `decls_in`. Each element becomes one declaration of
/// the given property name. Returns the extended list.
pub proc append_scalar_declarations(
    items: List<Json>,
    property: String,
    source: Option[SourceLocation],
    rule_selector: String,
    decls_in: List<IRDeclaration>
) -> List<IRDeclaration>
    var decls := decls_in
    var idx := 0
    while idx < items.length() {
        val item := items[idx]
        match item {
            case Str(_) then {
                val d := create_declaration(normalize_property(property), item, source, rule_selector)
                decls.append(d)
            }
            case NumInt(_) then {
                val d := create_declaration(normalize_property(property), item, source, rule_selector)
                decls.append(d)
            }
            case NumFloat(_) then {
                val d := create_declaration(normalize_property(property), item, source, rule_selector)
                decls.append(d)
            }
            case _ then {}
        }
        idx := idx + 1
    }
    return decls

// ============================================================================
// Phase 2C — parse_nested_object
// ============================================================================
//
// Ported from parseNestedObject in parser.ts. Handles ONLY:
//   - "&..." keys  → nested rules (replace ALL "&" with parent selector)
//   - string/number → declaration
//   - array         → multiple declarations
//   - object        → nested rule with "${selector} ${p}"
//
// Note: pseudo-class handling (&:hover, &::before) is NOT here — it
// lives in parseIR (parse_ir.gol), matching the TS source. The Phase 2
// guide's description of parseNestedObject conflated the two.

/// Replace every occurrence of `from` in `s` with `to`. Global replace,
/// matching JS `String.prototype.replace(/<from>/g, to)`.
/// Implemented as a single pass over chars; `from` is assumed to be a
/// single character (`&` in every call site).
pub proc replace_all(s: String, needle: String, to: String) -> String
    if needle.length() = 0 {
        return s
    } else {
        val needle_codepoint := Char.to_int(String.to_chars(needle)[0])
        val chars := String.to_chars(s)
        var out := ""
        var i := 0
        while i < chars.length() {
            if Char.to_int(chars[i]) = needle_codepoint {
                out := out + to
            } else {
                out := out + Char.to_string(chars[i])
            }
            i := i + 1
        }
        return out
    }

/// Trim leading and trailing ASCII whitespace.
proc trim_ascii(s: String) -> String
    val chars := String.to_chars(s)
    var lo := 0
    while lo < chars.length() {
        val n := Char.to_int(chars[lo])
        if n = 32 or n = 9 or n = 10 or n = 13 {
            lo := lo + 1
        } else {
            lo := chars.length()  // force exit
        }
    }
    var hi := chars.length()
    var scanning := true
    while hi > 0 and scanning {
        val n := Char.to_int(chars[hi - 1])
        if n = 32 or n = 9 or n = 10 or n = 13 {
            hi := hi - 1
        } else {
            scanning := false
        }
    }
    if lo >= hi {
        return ""
    } else {
        var out := ""
        var i := lo
        while i < hi {
            out := out + Char.to_string(chars[i])
            i := i + 1
        }
        return out
    }

/// Port of parseNestedObject from TS parser.ts.
/// Walks `value` (a Json object) and mutates `rule` by appending
/// declarations and nested rules. Pseudo-class handling is in
/// parse_ir.gol, not here.
pub proc parse_nested_object(
    selector: String,
    value: Json,
    rule_in: IRRule,
    source: Option[SourceLocation]
) -> IRRule
    var rule := rule_in
    match value {
        case Obj(map) then {
            for key in map.keys() {
                match map.get(key) {
                    case Some(v) then {
                        if starts_with(key, "&") {
                            val nested_selector := replace_all(key, "&", selector)
                            val base_rule := create_rule(nested_selector, source, Some(rule.id))
                            val nested_rule := parse_nested_object(nested_selector, v, base_rule, source)
                            rule.nestedRules.append(nested_rule)
                        } else {
                            rule := handle_nested_value(selector, key, v, rule, source)
                        }
                    }
                    case None then {}
                }
            }
        }
        case _ then {}
    }
    return rule

/// Dispatch one non-&-prefixed key/value pair per TS parseNestedObject:
/// string|number → declaration; array → multiple declarations;
/// object → nested rule. Other kinds are ignored (matching TS).
proc handle_nested_value(
    selector: String,
    key: String,
    value: Json,
    rule_in: IRRule,
    source: Option<SourceLocation>
) -> IRRule
    var rule := rule_in
    match value {
        case Str(_) then {
            val decl := create_declaration(normalize_property(key), value, source, rule.selector)
            rule.declarations.append(decl)
        }
        case NumInt(_) then {
            val decl := create_declaration(normalize_property(key), value, source, rule.selector)
            rule.declarations.append(decl)
        }
        case NumFloat(_) then {
            val decl := create_declaration(normalize_property(key), value, source, rule.selector)
            rule.declarations.append(decl)
        }
        case Arr(items) then {
            rule.declarations := append_scalar_declarations(
                items,
                key,
                source,
                rule.selector,
                rule.declarations
            )
        }
        case Obj(_) then {
            val child_selector := trim_ascii(selector + " " + key)
            val base_child := create_rule(child_selector, source, Some(rule.id))
            val child_rule := parse_nested_object(child_selector, value, base_child, source)
            rule.nestedRules.append(child_rule)
        }
        case _ then {}
    }
    return rule
    return rule

// ============================================================================
// Pseudo-class / Json-value helpers (G18 workaround for parse_ir.gol)
// ============================================================================
//
// Every helper here has its `match` at depth 1 (function body). Call
// chains replace depth-2+ matches in callers.

pub proc append_one_pseudo_value(
    value: Json,
    key: String,
    source: Option[SourceLocation],
    rule_selector: String,
    decls_in: List[IRDeclaration]
) -> List[IRDeclaration]
    var decls := decls_in
    match value {
        case Str(_) then {
            val d := create_declaration(normalize_property(key), value, source, rule_selector)
            decls.append(d)
        }
        case NumInt(_) then {
            val d := create_declaration(normalize_property(key), value, source, rule_selector)
            decls.append(d)
        }
        case NumFloat(_) then {
            val d := create_declaration(normalize_property(key), value, source, rule_selector)
            decls.append(d)
        }
        case Arr(items) then {
            decls := append_scalar_declarations(items, key, source, rule_selector, decls)
        }
        case Obj(inner_map) then {
            decls := dispatch_inner_obj(inner_map, key, source, rule_selector, decls)
        }
        case _ then {}
    }
    return decls

pub proc dispatch_inner_obj(
    inner_map: Map<String, Json>,
    outer_key: String,
    source: Option[SourceLocation],
    rule_selector: String,
    decls_in: List[IRDeclaration]
) -> List[IRDeclaration]
    var decls := decls_in
    for inner_key in inner_map.keys() {
        decls := dispatch_inner_opt(
            inner_map.get(inner_key), inner_key, outer_key, source, rule_selector, decls
        )
    }
    return decls

pub proc dispatch_inner_opt(
    opt: Option[Json],
    inner_key: String,
    outer_key: String,
    source: Option[SourceLocation],
    rule_selector: String,
    decls_in: List[IRDeclaration]
) -> List[IRDeclaration]
    match opt {
        case Some(inner_v) then {
            val pn := if inner_key = "color" and outer_key = "background" {
                "backgroundColor"
            } else {
                inner_key
            }
            return append_one_pseudo_value(inner_v, pn, source, rule_selector, decls_in)
        }
        case None then { return decls_in }
    }

pub proc append_dispatch_opt(
    opt: Option[Json],
    key: String,
    source: Option[SourceLocation],
    rule_selector: String,
    decls_in: List[IRDeclaration]
) -> List[IRDeclaration]
    match opt {
        case Some(v) then {
            return append_one_pseudo_value(v, key, source, rule_selector, decls_in)
        }
        case None then { return decls_in }
    }

