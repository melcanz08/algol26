// ============================================================================
// math-types.ts
// ============================================================================
//
// CSSUnit is a 26-string union. Modelled as String (validation deferred).
// MathResult.toString / .toCalc are function-valued (G23) and omitted.

pub rec CSSMathValue
    pub value: Float
    pub unit: String

pub rec MathContext
    pub rootFontSize: Option[Float]
    pub viewportWidth: Option[Float]
    pub viewportHeight: Option[Float]
    pub parentFontSize: Option[Float]
    pub dpi: Option[Float]
    pub elementWidth: Option[Float]
    pub elementHeight: Option[Float]

pub rec MathResult
    pub value: Float
    pub unit: String
    pub expression: String
    pub resolved: Option[CSSMathValue]
    pub explanations: List[String]

pub rec FluidTypeConfig
    pub minSize: Float
    pub maxSize: Float
    pub minWidth: Option[Float]
    pub maxWidth: Option[Float]
    pub unit: Option[String]
    pub rootFontSize: Option[Float]
