// shorthand.gol — Phase 2A. Port of src/shared/types/shorthand-types.ts
// and src/shared/types/math-types.ts.
//
// Every shorthand field in TS is Dynamic<T> = T | (() => T). Function
// form is not representable in ALGOL26 (G23). Each field is Option[Json]
// so scalar (Str/NumInt/NumFloat/Bool/Arr) and "resolved at the seam"
// forms share one carrier. Matches ir_types.gol's value: Json.
//
// String-literal unions ("row"|"column"|"flex-start"|...) become String
// (validation deferred — matches IRAtRule.type, IRDiagnostic.severity).
//
// MathResult.toString / .toCalc are function-valued fields and are
// omitted (G23). MathResult.value / .unit / .expression / .resolved /
// .explanations are kept.

import "json.gol"

