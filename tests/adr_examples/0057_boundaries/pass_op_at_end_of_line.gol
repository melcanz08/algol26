// EXPECT: COMPILE
// ADR 0057. Operator at end of previous line with the continuation
// indented deeper: the lexer suppresses the Indent for lines whose
// predecessor ends in a binary operator, so this parses as one
// expression. See `Lexer::token_requires_continuation`.
proc main()
    val a := 10
    val b := 3
    val total := a +
        b
    print(total)
