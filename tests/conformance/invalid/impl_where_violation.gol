// ERROR_CODE: E0002
trait Sortable
    function sort_me(self: &Self) -> String

trait Ordered
    function cmp(self: &Int, other: Int) -> Int

impl Ordered for Int
    function cmp(self: &Int, other: Int) -> Int
        return 0

impl<T> Sortable for List<T> where T: Ordered
    function sort_me(self: &List<T>) -> String
        return "sorted"

rec Foo
    x: Int

proc main
    val fs: List<Foo> := [Foo { x: 1 }]
    print(fs.sort_me())
