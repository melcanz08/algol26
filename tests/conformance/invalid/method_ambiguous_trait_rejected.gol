// ERROR_CODE: E0010
rec User
    name: String

trait Saveable
    proc save(self: &User)

trait Persistable
    proc save(self: &User)

impl Saveable for User
    proc save(self: &User)
        print("saveable")

impl Persistable for User
    proc save(self: &User)
        print("persistable")

proc main
    val u := User { name: "Alice" }
    u.save()
