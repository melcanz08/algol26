trait Container
    type Item
    function first(self: &Self) -> Self::Item

rec IntBox
    value: Int

rec FloatBox
    value: Float

impl Container for IntBox
    type Item := Int
    function first(self: &IntBox) -> Int
        return self.value

impl Container for FloatBox
    type Item := Float
    function first(self: &FloatBox) -> Float
        return self.value

proc main
    val bi := IntBox { value: 42 }
    val bf := FloatBox { value: 3.5 }
    print(bi.first())
    print(bf.first())
