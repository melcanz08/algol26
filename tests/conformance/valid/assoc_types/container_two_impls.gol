trait Container
    type Item
    fn first(self: &Self) -> Self::Item

rec IntBox
    value: Int

rec FloatBox
    value: Float

impl Container for IntBox
    type Item := Int
    fn first(self: &IntBox) -> Int
        self.value
impl Container for FloatBox
    type Item := Float
    fn first(self: &FloatBox) -> Float
        self.value
proc main
    val bi := IntBox { value: 42 }
    val bf := FloatBox { value: 3.5 }
    print(bi.first())
    print(bf.first())
