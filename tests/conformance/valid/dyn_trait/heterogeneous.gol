trait Shape
    function area(self: &Self) -> Float

rec Circle
    r: Float

rec Square
    side: Float

impl Shape for Circle
    function area(self: &Circle) -> Float
        return 3.14159 * self.r * self.r

impl Shape for Square
    function area(self: &Square) -> Float
        return self.side * self.side

proc main
    val c := Circle { r: 2.0 }
    val sq := Square { side: 3.0 }
    val s1: &dyn Shape := &c
    val s2: &dyn Shape := &sq
    print(s1.area())
    print(s2.area())
