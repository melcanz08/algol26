trait Shape
    fn area(self: &Self) -> Float

rec Circle
    r: Float

rec Square
    side: Float

impl Shape for Circle
    fn area(self: &Circle) -> Float
        3.14159 * self.r * self.r
impl Shape for Square
    fn area(self: &Square) -> Float
        self.side * self.side
proc main
    val c := Circle { r: 2.0 }
    val sq := Square { side: 3.0 }
    val s1: &dyn Shape := &c
    val s2: &dyn Shape := &sq
    print(s1.area())
    print(s2.area())
