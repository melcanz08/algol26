trait Shape
    fn area(self: &Self) -> Float
    fn name(self: &Self) -> String

rec Circle
    r: Float

impl Shape for Circle
    fn area(self: &Circle) -> Float
        3.14159 * self.r * self.r
    fn name(self: &Circle) -> String
        "circle"
proc main
    val c := Circle { r: 1.0 }
    val s: &dyn Shape := &c
    print(s.area())
    print(s.name())
