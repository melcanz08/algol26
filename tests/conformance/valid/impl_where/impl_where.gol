trait Sortable
    fn sort_me(self: &Self) -> String

trait Ordered
    fn cmp(self: &Int, other: Int) -> Int

impl Ordered for Int
    fn cmp(self: &Int, other: Int) -> Int
        0
impl<T> Sortable for List<T> where T: Ordered
    fn sort_me(self: &List<T>) -> String
        "sorted"
proc main
    val xs: List<Int> := [3, 1, 2]
    print(xs.sort_me())
