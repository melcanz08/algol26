// BACKEND: interpreter
// OUTPUT: Lines: 3
// OUTPUT: Words: 12
// OUTPUT: Unique: 8
// OUTPUT: brown 1
// OUTPUT: dog 1
// OUTPUT: fox 2
// OUTPUT: jumps 2
// OUTPUT: lazy 1
// OUTPUT: over 1
// OUTPUT: quick 1
// OUTPUT: the 3
//
// Exercises String.split, String.trim, String.length, List.length,
// List iteration, Map construction and methods, Option match,
// nested loops with continue.
proc count_words(text: String) -> Map<String, Int>
    var counts: Map<String, Int> := Map {}
    val lines := String.split(text, "\n")
    for line in lines
        val trimmed := String.trim(line)
        if String.length(trimmed) = 0
            continue
        val words := String.split(trimmed, " ")
        for w in words
            val word := String.trim(w)
            if String.length(word) = 0
                continue
            if counts.contains(word)
                match counts.get(word)
                    case Some(n)
                        counts.insert(word, n + 1)
                    case None
                        counts.insert(word, 1)
            else
                counts.insert(word, 1)
    return counts

proc main
    val sample := "the quick brown fox\njumps over the lazy dog\nthe fox jumps"
    val lines := String.split(sample, "\n")
    print("Lines: " + Int.to_string(List.length(lines)))

    var total_words := 0
    for line in lines
        val trimmed := String.trim(line)
        if String.length(trimmed) = 0
            continue
        val words := String.split(trimmed, " ")
        for w in words
            val word := String.trim(w)
            if String.length(word) > 0
                total_words := total_words + 1
    print("Words: " + Int.to_string(total_words))

    val counts := count_words(sample)
    print("Unique: " + Int.to_string(counts.length()))

    val keys := counts.keys()
    for k in keys
        match counts.get(k)
            case Some(n)
                print(k + " " + Int.to_string(n))
            case None
                print(k + " ?")
