// Set union, intersection, and difference. Prints the size of
// each result by testing membership of all seven days.
enum Day
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday

proc main
    val a: Set<Day> := Set<Day> { Day.Monday, Day.Tuesday }
    val b: Set<Day> := Set<Day> { Day.Tuesday, Day.Wednesday }
    val u: Set<Day> := a + b
    val i: Set<Day> := a * b
    val d: Set<Day> := a - b

    // u = {Mon, Tue, Wed} — Mon in u
    if Day.Monday in u
        print(1)
    // i = {Tue} — Tue in i
    if Day.Tuesday in i
        print(2)
    // d = {Mon} — Mon in d
    if Day.Monday in d
        print(3)
    // Wed not in d
    if Day.Wednesday in d
        print(4)
end