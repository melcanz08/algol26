// BACKEND: interpreter
// OUTPUT: 3.14
// OUTPUT: 0.5
// OUTPUT: -2.5
// OUTPUT: 1
// OUTPUT: 0
// OUTPUT: 0.3333333333333333
//
// Float.to_string formats per ECMA-262 §7.1.12.1
// (Number::toString), matching JavaScript's String(x) output
// byte-for-byte. See LANGUAGE_GAPS.md G34 for the change and the
// 2/10,000 known-divergence cases.
//
// FIXME(G34): the LLVM and WASM backends still use the old
// `sprintf("%.6f") + strip` formatter and produce `"0.333333"`
// for `1/3` where the interpreter produces
// `"0.3333333333333333"`. Re-enable the `llvm` and `wasm` tokens
// on the `BACKEND` line above once `runtime/float.c` (or the
// equivalent Rust `extern "C"` helper) is wired into the build.
// The `1/3` case is the discriminator: it will fail on the
// LLVM/WASM legs until the formatter is fixed there.
proc main
    print(Float.to_string(3.14))
    print(Float.to_string(0.5))
    print(Float.to_string(-2.5))
    print(Float.to_string(1.0))
    print(Float.to_string(0.0))
    print(Float.to_string(1.0 / 3.0))
