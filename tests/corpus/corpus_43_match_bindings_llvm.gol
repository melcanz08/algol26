// Match with binding patterns on LLVM. Pins the end-to-end
// status of `case Some(v)` style patterns on the native
// backend. Companion to corpus_40 (Option), which uses the
// same shape.
// OUTPUT: 5
// OUTPUT: none

fn find(x: Int) -> Option<Int>
    if x > 0 then Some(x) else None

proc main
    val a := find(5)
    match a
        case Some(v) then print(Int.to_string(v))
        case None then print("none")
    val b := find(-1)
    match b
        case Some(v) then print(Int.to_string(v))
        case None then print("none")
