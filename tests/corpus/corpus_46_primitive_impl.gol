// Primitive inherent impls: dispatcher parity between the
// analyzer's MethodCall and FunctionCall arms and the builder's
// resolve_method_call. Variable receiver and field receiver must
// both resolve `{Base}_{method}` after the dot-form builtin tier.
//
// Regression pin for the two-tier fix. See docs/STATUS.md.

// OUTPUT: 4
// OUTPUT: 6
// OUTPUT: 14

rec Point
    x: Int
    y: Int

impl Int
    fn inc(self: Int) -> Int
        self + 1

    fn double(self: Int) -> Int
        self * 2

proc main
    val p := Point { x: 3, y: 4 }
    // Field receiver -- MethodCall arm
    print(Int.to_string(p.x.inc()))
    // Variable receiver -- FunctionCall arm
    val x := 5
    print(Int.to_string(x.inc()))
    // Two-arg-ish shape via by-value receiver on a primitive
    print(Int.to_string(x.double() + p.y))
