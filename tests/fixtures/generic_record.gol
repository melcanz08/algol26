// supported: interpreter llvm wasm
// `rec Box<T>` — generic records. `map_type(Type::Record(name, args))`
// mangles the cache key to distinguish Box<Int> (i64 field) from
// Box<String> (i8* field); `resolve_field_type_with_subst` resolves
// `value: T` against the instantiation's concrete type args.
// Change the header above when the compiled backends lower it.
rec Box<T>
    value: T

proc main
    val b := Box<Int> { value: 42 }
    print(Int.to_string(b.value))
