// supported: interpreter llvm wasm
// String.split returns List<String>. LLVM lowers it via
// runtime/string.c (algol26_string_split); WASM reaches the same
// runtime symbol through runtime/wasm/host.js, which now provides
// algol26_string_split and algol26_string_join.
proc main
    val parts := "a,b,c".split(",")
    print(Int.to_string(parts.length()))
