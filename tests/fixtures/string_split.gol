// supported: interpreter llvm
// String.split returns List<String>. LLVM lowers it via
// runtime/string.c (algol26_string_split); WASM still refuses at
// the capability boundary (Feature::StringSplit is not in
// wasm().supported).
proc main
    val parts := "a,b,c".split(",")
    print(Int.to_string(parts.length()))
