// supported: interpreter llvm wasm
// try/catch lowers to a Switch on the Result tag plus per-branch
// blocks. The TryCatchMarker instruction is a no-op in codegen.
// Works on all three backends (interpreter, LLVM, WASM) since the
// builder path and IRCodeGen are shared.

proc main
    val ok := try
        Ok(5)
    catch e
        99
    print(Int.to_string(ok))

    val err := try
        Error(0)
    catch e
        99
    print(Int.to_string(err))
