procedure main
    val greeting := "Hello"
    val name := "World"
    
    val combined := String.concat(greeting, " ")
    val full_greeting := String.concat(combined, name)
    
    print(full_greeting)
    
    val len := String.length(full_greeting)
    print(len)
    
    val upper := String.to_upper(full_greeting)
    print(upper)
    
    val sub := String.substring(full_greeting, 0, 5)
    print(sub)
